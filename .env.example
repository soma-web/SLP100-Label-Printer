# Nach .env kopieren und anpassen.

# Passwort der Weboberflaeche (leer = ohne Anmeldung, nur fuer vertrauenswuerdige Netze)
SLP_PASSWORD=
SLP_USERNAME=admin

# Port auf dem Host; "127.0.0.1:8100" = nur lokal erreichbar
SLP_PUBLISH=8100

# Eigene Hostnamen, wenn kein Passwort gesetzt ist (Komma-getrennt)
SLP_ALLOWED_HOSTS=

# MCP-Server beim ersten Start aktivieren (spaeter in den Einstellungen umschaltbar)
SLP_MCP=0
# Leer = wird erzeugt und in den Einstellungen angezeigt
SLP_MCP_TOKEN=

# auto | usbfs | usblp | mock (Simulator)
SLP_BACKEND=auto

# Gruppe des USB-Druckers auf dem Host: stat -c %g /dev/bus/usb/BBB/DDD
LP_GID=7
